{
  "name": "baseline",
  "budgetUsd": 200,
  "benchmark": {
    "repo": "https://github.com/withmartian/code-review-benchmark.git",
    "commit": "e616e849755441da38f18bf3adba2c9583b03803"
  },
  "tool": "diff2ai",
  "reviewer": {
    "runner": "eval-api",
    "model": "claude-opus-5-5",
    "effort": "medium",
    "maxTokens": 64000,
    "reviewArgs": []
  },
  "judge": {
    "model": "claude-opus-4-5-20251101",
    "baseUrl": "https://api.anthropic.com/v1/",
    "apiKeyEnv": "ANTHROPIC_API_KEY"
  },
  "split": { "seed": 20261112, "devPerSource": 2 },
  "pricingUsdPerMTok": {
    "claude-opus-5-5": { "input": 4, "output": 20 },
    "claude-sonnet-5-5": { "input": 2, "output": 10 },
    "claude-haiku-5-5": { "input": 0.1, "output": 0.5 },
    "claude-fable-5-2": { "input": 8, "output": 40 },
    "claude-opus-4-5-20251101": { "input": 5, "output": 25 }
  },
  "estimate": {
    "reviewerOutputTokens": { "low": 3000, "high": 8000 },
    "candidatesPerPr": { "low": 5, "high": 10 },
    "judgeCallTokens": { "input": 350, "output": 100 },
    "extractDedupTokens": { "input": 4000, "output": 1000 }
  }
}
