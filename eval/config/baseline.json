{
  "name": "baseline",
  "budgetUsd": 200,
  "benchmark": {
    "repo": "https://github.com/withmartian/code-review-benchmark.git",
    "commit": "e616e849755441da38f18bf3adba2c9583b03803"
  },
  "tool": "diff2ai",
  "reviewer": {
    "runner": "eval-api",
    "model": "claude-opus-5-5",
    "effort": "medium",
    "maxTokens": 64000,
    "reviewArgs": []
  },
  "judge": {
    "model": "claude-opus-4-5-20251101",
    "baseUrl": "https://api.anthropic.com/v1/",
    "apiKeyEnv": "ANTHROPIC_API_KEY"
  },
  "split": { "seed": 20261112, "devPerSource": 2 },
  "pricingUsdPerMTok": {
    "claude-opus-5-5": { "input": 4, "output": 20 },
    "claude-sonnet-5-5": { "input": 2, "output": 10 },
    "claude-haiku-5-5": { "input": 0.1, "output": 0.5 },
    "claude-fable-5-2": { "input": 8, "output": 40 },
    "claude-opus-4-5-20251101": { "input": 5, "output": 25 }
  },
  "estimate": {
    "basis": "eval/results/m1-smoke (3 PRs): 2.1-2.5 prompt chars per input token, 2.7k-6.0k output tokens per review, 6-13 candidates per PR, 242 in / 103 out per judge call",
    "promptCharsPerToken": { "low": 2.7, "high": 2.0 },
    "reviewerOutputTokens": { "low": 2500, "high": 8000 },
    "candidatesPerPr": { "low": 6, "high": 14 },
    "judgeCallTokens": { "input": 250, "output": 105 },
    "extractDedupTokens": { "input": 2500, "output": 400 }
  }
}
