{
  "name": "diff2ai",
  "version": "0.3.0",
  "description": "Turn Git diffs into high-signal AI code reviews: any AI CLI, multi-reviewer consensus, inline PR comments, SARIF",
  "license": "MIT",
  "author": "Nurettin Coban",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "diff2ai": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "prepare": "npm run build",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nurettincoban/diff2ai.git"
  },
  "homepage": "https://nurettincoban.github.io/diff2ai/",
  "bugs": {
    "url": "https://github.com/nurettincoban/diff2ai/issues"
  },
  "keywords": [
    "git",
    "diff",
    "code-review",
    "ai",
    "llm",
    "prompt",
    "review",
    "cli",
    "claude",
    "codex",
    "gemini",
    "ollama",
    "github-action",
    "sarif",
    "pull-request"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^9.35.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "clipboardy": "^4.0.0",
    "commander": "^14.0.0",
    "cross-spawn": "^7.0.6",
    "json5": "^2.2.3",
    "minimatch": "^10.2.6",
    "ora": "^8.2.0",
    "simple-git": "^3.36.0"
  }
}
